config secondary_board
    string
    default "$(board)"

config secondary_toolchain
    string
    default "$(toolchain)"

# This is for internal board support
osource "${SdkRootDirPath}/${board_root}/${board}/tfm_examples/Kconfig.sysbuild"

# This is for external custom board support
osource "${CUSTOM_BOARD_ROOT}/${board}/tfm_examples/Kconfig.sysbuild"