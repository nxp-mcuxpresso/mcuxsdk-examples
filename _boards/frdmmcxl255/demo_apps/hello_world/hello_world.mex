         <functions_list>
            <function name="BOARD_InitPins">
               <description>Configures pin routing and optionally pin electrical features.</description>
               <options>
                  <callFromInitBoot>true</callFromInitBoot>
                  <coreID>cm33</coreID>
                  <enableClock>true</enableClock>
               </options>
               <dependencies/>
               <pins>
                  <pin peripheral="LPUART2" signal="TXD" pin_num="C10" pin_signal="P1_12/TRIG_IN1/LPUART2_TXD/CT_INP13/UTICK_CAP0/PWM0_B1">
                     <pin_features>
                        <pin_feature name="pull_value" value="low"/>
                        <pin_feature name="pull_enable" value="disable"/>
                        <pin_feature name="pull_select" value="down"/>
                        <pin_feature name="invert_input" value="normal"/>
                        <pin_feature name="input_buffer" value="disable"/>
                        <pin_feature name="drive_strength" value="low"/>
                        <pin_feature name="drive_strength1" value="normal"/>
                        <pin_feature name="open_drain" value="disable"/>
                        <pin_feature name="passive_filter" value="disable"/>
                        <pin_feature name="slew_rate" value="fast"/>
                     </pin_features>
                  </pin>
                  <pin peripheral="LPUART2" signal="RXD" pin_num="B10" pin_signal="P1_13/TRIG_IN2/LPUART2_RXD/CT_INP14/UTICK_CAP1/PWM0_A1/WUU_P19">
