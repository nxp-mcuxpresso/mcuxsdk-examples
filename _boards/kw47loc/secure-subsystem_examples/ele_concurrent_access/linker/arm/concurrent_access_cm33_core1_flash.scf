#! armcc -E
/*
** ###################################################################
**     Processor:           KW47B42ZB7AFTA_cm33_core1
**     Compiler:            Keil ARM C/C++ Compiler
**     Reference manual:    Rev. 6, 05/22/2022
**     Version:             rev. 1.0, 2023-05-20
**     Build:               b240814
**
**     Abstract:
**         Linker file for the Keil ARM C/C++ Compiler
**
