config secondary_config
    string
    default "debug" if $(config) = "debug"
    default "release" if $(config) = "release"

config secondary_core_id
    string
    default "cm7_core1" if $(core_id) = "cm33_core1"
    default "cm7_core0" if $(core_id) = "cm33_core1"
    default "cm7_core1" if $(core_id) = "cm7_core0"
    default "cm33_core1" if $(core_id) = "cm7_core0"
    default "cm33_core1" if $(core_id) = "cm7_core1"
    default "cm7_core0" if $(core_id) = "cm7_core1"
