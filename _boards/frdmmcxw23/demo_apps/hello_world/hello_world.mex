                  <pin peripheral="FLEXCOMM0" signal="TXD_SCL_MISO" pin_num="3" pin_signal="PIO0_3/FC0_TXD_SCL_MISO/SCT_OUT8/FREQME_GPIO_3/SEC_PIO0_3/CTIMER0_MAT3/CTIMER_INP3">
                     <pin_features>
