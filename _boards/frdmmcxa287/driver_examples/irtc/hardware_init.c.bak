/*${header:start}*/
#include "pin_mux.h"
#include "fsl_clock.h"
#include "board.h"
/*${header:end}*/

/*${function:start}*/
void BOARD_InitHardware(void)
{
    BOARD_InitDEBUG_UARTPins();
    BOARD_InitBootClocks();
    BOARD_InitDebugConsole();

#if 0
    /* RTC peripheral default uses the OSC32K */
    CLOCK_SetupOsc32KClocking(kCLOCK_Osc32kToAll);
    
#else
    osc_32k_config_t config;
    CLOCK_GetDefaultOsc32KConfig(&config);
    
    config.mode     = kVBAT_OscStartupModeEnable;
    config.xtalCap  = kVBAT_OscXtal12pFCap;
    config.extalCap = kVBAT_OscExtal12pFCap;
    config.ampGain  = kVBAT_OscCoarseAdjustment10;    
    config.id       = kCLOCK_Osc32kToAll;
    
    CLOCK_SetupOsc32KClockingConfig(config);

#endif
}
/*${function:end}*/
