**     mail:                 support@nxp.com
**
** ###################################################################
*/


/* Sizes */
#if (defined(__stack_size__))
  #define Stack_Size                   __stack_size__
#else
  #define Stack_Size                   0x0400
#endif

#if (defined(__heap_size__))
  #define Heap_Size                    __heap_size__
#else
  #define Heap_Size                    0x0400
#endif

#define  m_interrupts_start            0x00000000
#define  m_interrupts_size             0x00000400

#define  m_text_start                  0x00000400
#define  m_text_size                   0x000FFC00

#define  m_data0_start                  0x04000000
#define  m_data0_size                   0x00004000

#define  m_data1_start                  0x20000000
#define  m_data1_size                   0x0001C000

LR_m_text m_text_start m_text_size {   ; load region size_region
  ER_m_text m_text_start FIXED m_text_size { ; load address = execution address
    * (InRoot$$Sections)
    .ANY (+RO)
  }
  RW_m_data0 m_data0_start m_data0_size { ; RW data
    mflash_drv.o (+RO)
    .ANY (+RW +ZI)
  }

  RW_m_memfault_bss m_data1_start ALIGN 4 { ; Memfault captured BSS
    tasks.o (+ZI)
    timers.o (+ZI)
  }

  RW_m_data1 +0 ALIGN 4 { ; RW data
    .ANY (+RW +ZI)
  }

  NOINIT_RAM +0 UNINIT { ;no init section
    *(.noinit.mflt*)
  }

  ARM_LIB_HEAP +0 EMPTY Heap_Size {    ; Heap region growing up
  }
  ARM_LIB_STACK m_data1_start+m_data1_size EMPTY -Stack_Size { ; Stack region growing down
  }

  ScatterAssert((ImageLength(RW_m_memfault_bss) + ImageLength(RW_m_data1) + ImageLength(NOINIT_RAM)) + Heap_Size + Stack_Size < m_data1_size)
}

LR_m_interrupts m_interrupts_start m_interrupts_size {
  VECTOR_ROM m_interrupts_start m_interrupts_size { ; load address = execution address
    * (RESET,+FIRST)
  }
}
