# FreeRTOS board config
if MCUX_COMPONENT_middleware.freertos-kernel
    config configENABLE_FPU
        default n

    config configENABLE_MPU
        default n

    config configENABLE_TRUSTZONE
        default n

    config configRUN_FREERTOS_SECURE_ONLY
        default y
endif

config HAL_RPMSG_SELECT_ROLE
    default n

if MCUX_COMPONENT_utilities.gcov
    config MCUX_COMPONENT_utilities.gcov.board_init
        select MCUX_COMPONENT_driver.cmc
        default y
endif
