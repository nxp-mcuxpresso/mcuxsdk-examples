source "Kconfig.mcuxpresso"

# Enable the edgefast_open shell porting layer (fsl_shell). PORT_SHELL is a
# hidden symbol normally selected by BT_SHELL; this app uses the plain fsl_shell
# API directly (app_shell.c) and registers its own "bt"/"spp"/"wifi" commands, so
# we enable PORT_SHELL here WITHOUT BT_SHELL. BT_SHELL is intentionally left off
# to avoid the full edgefast_open bt shell registering a conflicting top-level
# "bt" command in bt.c.
config COEX_SPP_ENABLE_PORT_SHELL
	bool
	default y
	select PORT_SHELL
