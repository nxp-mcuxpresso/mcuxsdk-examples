menu "Project Settings"

config BUFFER_LENGTH
    int "Number of buffer length"
    default 16
    help
        No prefix in generated macro

config HALF_BUFFER_LENGTH
    int "Number of half buffer length"
    default 8
    help
        This value should be half of BUFFER_LENGTH
        No prefix in generated macro

endmenu

source "${SdkRootDirPath}/Kconfig.mcuxpresso"