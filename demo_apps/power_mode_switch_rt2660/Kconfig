mainmenu "power_mode_switch_rt2660"

# When the PMIC path is enabled, bound the LPI2C blocking waits so a stuck/NAKing bus returns
# kStatus_LPI2C_Timeout (reached before __WFI) instead of hanging. Declared BEFORE the main source so
# this conditional default is evaluated ahead of the lpi2c driver's unconditional "default 0" (first
# matching default wins). Only takes effect with lpi2c selected (PMIC on); the default DCDC build
# keeps 0 (= wait forever, driver default). Loop-iteration ceiling, not wall-clock; tune on HW.

# Need to refer the root Kconfig.mcuxpresso to get all Kconfig data
source "${SdkRootDirPath}/Kconfig.mcuxpresso"

# Board example specific Kconfig can be linked in this way if needed
osource "${SdkRootDirPath}/${project_board_port_path}/Kconfig"

config MCUX_EXAMPLE_power_mode_switch_rt2660
    bool "power_mode_switch_rt2660 example"
    default y
